{
  "name": "my-music-app",
  "version": "1.0.0",
  "description": "Music playlist app with user authentication",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "build": "npm run build --prefix client",
    "dev": "nodemon backend/server.js",
    "client": "npm run dev --prefix client",
    "client-build": "npm run build --prefix client",
    "dev-all": "concurrently \"npm run dev\" \"npm run client\""
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "mongoose": "^8.0.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.10"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "nodemon": "^2.0.20"
  }
}
